# Comma-separated public Tiramisu wallet addresses allowed to inspect private
# evidence and publish trusted authority actions. Citizen reports do not use
# this allowlist. Never put wallet private keys here.
SADAKSETU_AUTHORITY_OWNERS=0xREPLACE_WITH_AUTHORITY_WALLET

# Optional 64-character hex key used by arkiv-encryption on the server. Use a
# dedicated random key (not a wallet key) and keep a private backup. In local
# development, an in-memory key is generated when this is empty. It changes on
# restart, so Arkiv ciphertext created with it can no longer be decrypted.
SADAKSETU_EVIDENCE_KEY=

# Optional server-only Tiramisu access key. This prevents the public read feeds
# from sharing Arkiv's anonymous query quota. Create one at:
# https://hub.arkiv.network/access-keys
# Never expose this value through NEXT_PUBLIC_*.
ARKIV_API_KEY=
